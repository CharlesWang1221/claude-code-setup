---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<Base title="網誌" description="老查與阿分的文字基地，記錄每一集背後的思考碎片。">
  <section class="blog-hero">
    <div class="container">
      <p class="section-eyebrow reveal">網誌</p>
      <h1 class="blog-title reveal reveal-d1">文字的<br />不標準答案</h1>
      <p class="blog-sub reveal reveal-d2">每篇文章，都是對「標準答案」的一次溫柔抵抗。</p>
    </div>
  </section>

  <section class="blog-list container">
    <div class="cards-2col">
      {posts.map((post) => (
        <a href={`/blog/${post.slug}`} class="media-card reveal">
          {post.data.image && (
            <div class="media-card-thumb">
              <img src={post.data.image} alt={post.data.title} loading="lazy" />
            </div>
          )}
          <div class="media-card-body">
            <time class="media-card-meta">{post.data.date}</time>
            <h2 class="media-card-title">{post.data.title}</h2>
            {post.data.description && (
              <p class="media-card-desc">{post.data.description}</p>
            )}
            <span class="media-card-more">閱讀全文 →</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .blog-hero {
    padding: 6rem 0 4rem;
    background: linear-gradient(180deg, #1A0A45 0%, #15083A 100%);
    border-bottom: 1px solid var(--rule);
  }

  .blog-title {
    font-family: var(--heading);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
    background: linear-gradient(135deg, #EE359E 0%, #815BDB 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin: 0.6rem 0 1rem;
    text-wrap: balance;
  }

  .blog-sub {
    font-size: 0.92rem;
    color: var(--muted);
    line-height: 1.7;
    max-width: 500px;
  }

  .blog-list {
    padding: 4rem 0 6rem;
  }
</style>
