---
import Base from '../layouts/Base.astro';

const videos = [
  // 之後在這裡補上影片資料，格式如下：
  // {
  //   id: 'YouTube影片ID',
  //   title: '影片標題',
  //   date: '2026-01-01',
  //   description: '影片描述',
  // },
];
---

<Base title="影音 | 不標準答案" description="《不標準答案》YouTube 影片頻道，用鏡頭記錄每一集的思考現場。">
  <section class="videos-hero">
    <div class="container">
      <p class="section-eyebrow reveal">影音</p>
      <h1 class="videos-title reveal reveal-d1">用鏡頭說<br />不標準答案</h1>
      <p class="videos-sub reveal reveal-d2">Podcast 之外，我們也在鏡頭前說話。</p>
      <a
        href="https://www.youtube.com/@不標準答案"
        target="_blank"
        rel="noopener noreferrer"
        class="yt-btn reveal reveal-d3"
      >
        訂閱 YouTube 頻道 →
      </a>
    </div>
  </section>

  <section class="videos-grid container">
    {videos.length === 0 ? (
      <div class="empty-state">
        <p class="empty-icon">🎬</p>
        <p class="empty-text">影片內容即將上線</p>
        <p class="empty-sub">先去 YouTube 訂閱，不錯過任何更新。</p>
      </div>
    ) : (
      <div class="cards-2col">
        {videos.map((v) => (
          <a
            href={`https://www.youtube.com/watch?v=${v.id}`}
            target="_blank"
            rel="noopener noreferrer"
            class="media-card reveal"
          >
            <div class="media-card-thumb">
              <img
                src={`https://img.youtube.com/vi/${v.id}/mqdefault.jpg`}
                alt={v.title}
                loading="lazy"
              />
              <div class="media-card-play">▶</div>
            </div>
            <div class="media-card-body">
              <time class="media-card-meta">{v.date}</time>
              <h2 class="media-card-title">{v.title}</h2>
              {v.description && <p class="media-card-desc">{v.description}</p>}
            </div>
          </a>
        ))}
      </div>
    )}
  </section>
</Base>

<style>
  .videos-hero {
    padding: 6rem 0 4rem;
    background: linear-gradient(180deg, #1A0A45 0%, #15083A 100%);
    border-bottom: 1px solid var(--rule);
  }

  .videos-title {
    font-family: var(--serif);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
    background: linear-gradient(135deg, #EE359E 0%, #815BDB 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin: 0.6rem 0 1rem;
    text-wrap: balance;
  }

  .videos-sub {
    font-size: 0.92rem;
    color: var(--muted);
    line-height: 1.7;
    max-width: 500px;
    margin-bottom: 1.8rem;
  }

  .yt-btn {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    background: linear-gradient(135deg, #EE359E, #815BDB);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    border: 1px solid rgba(238,53,158,0.35);
    padding: 0.6rem 1.2rem;
    border-radius: 2px;
    transition: border-color 0.2s, background 0.2s;
  }

  .yt-btn:hover {
    border-color: rgba(238,53,158,0.7);
    background: linear-gradient(135deg, rgba(238,53,158,0.08), rgba(129,91,219,0.08));
    -webkit-text-fill-color: unset;
    color: #815BDB;
  }

  .videos-grid {
    padding: 4rem 0 6rem;
  }

  .empty-state {
    text-align: center;
    padding: 5rem 0;
  }

  .empty-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .empty-text {
    font-family: var(--serif);
    font-size: 1.3rem;
    color: var(--body);
    margin-bottom: 0.5rem;
  }

  .empty-sub {
    font-size: 0.88rem;
    color: var(--muted);
  }
</style>
