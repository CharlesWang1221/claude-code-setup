---
import Base from '../layouts/Base.astro';
import { XMLParser } from 'fast-xml-parser';
const response = await fetch('https://www.youtube.com/feeds/videos.xml?channel_id=UCE-QusSupACm0Lk7D0ThHLQ', { signal: AbortSignal.timeout(15000) });
if (!response.ok) throw new Error(`YouTube feed: ${response.status}`);
const entries = new XMLParser().parse(await response.text()).feed?.entry;
const videos = (Array.isArray(entries) ? entries : entries ? [entries] : []).map((entry) => ({
  id: String(entry['yt:videoId'] || ''), title: String(entry.title || ''),
  date: new Intl.DateTimeFormat('sv-SE', { timeZone: 'Asia/Taipei' }).format(new Date(entry.published)),
})).filter((video) => /^[A-Za-z0-9_-]{11}$/.test(video.id) && video.title);
if (!videos.length) throw new Error('Empty YouTube feed');
---
<Base title="影音" description="《不標準答案》YouTube 影片">
  <section class="hero"><div class="container"><p>影音</p><h1>用鏡頭說<br />不標準答案</h1><p>Podcast 之外，我們也在鏡頭前說話。</p><a class="channel" href="https://www.youtube.com/channel/UCE-QusSupACm0Lk7D0ThHLQ" target="_blank" rel="noopener noreferrer">訂閱 YouTube 頻道 →</a></div></section>
  <section class="videos-grid container"><div class="cards-2col">
    {videos.map((v) => <a href={`https://www.youtube.com/watch?v=${v.id}`} target="_blank" rel="noopener noreferrer" class="media-card video-link" data-video-id={v.id} data-video-title={v.title}>
      <div class="media-card-thumb"><img src={`https://img.youtube.com/vi/${v.id}/hqdefault.jpg`} alt={v.title} loading="lazy" /><div class="media-card-play">▶</div></div>
      <div class="media-card-body"><time class="media-card-meta">{v.date}</time><h2 class="media-card-title">{v.title}</h2></div>
    </a>)}
  </div><p class="more"><a href="https://www.youtube.com/channel/UCE-QusSupACm0Lk7D0ThHLQ" target="_blank" rel="noopener noreferrer">到 YouTube 看更多影片 →</a></p></section>
  <dialog class="video-dialog" aria-label="觀看 YouTube 影片">
    <div class="dialog-header"><strong class="dialog-title"></strong><button type="button" class="dialog-close" aria-label="關閉影片">✕</button></div>
    <div class="video-frame"><iframe title="YouTube 影片播放器" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe></div>
    <a class="video-external" target="_blank" rel="noopener noreferrer">在 YouTube 觀看 ↗</a>
  </dialog>
  <script>
    const dialog = document.querySelector<HTMLDialogElement>('.video-dialog');
    const iframe = dialog?.querySelector<HTMLIFrameElement>('iframe');
    const title = dialog?.querySelector<HTMLElement>('.dialog-title');
    const external = dialog?.querySelector<HTMLAnchorElement>('.video-external');
    if (dialog && iframe && title && external) {
      document.querySelectorAll<HTMLAnchorElement>('.video-link').forEach((link) => {
        link.addEventListener('click', (event) => {
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          const id = link.dataset.videoId;
          if (!id || !/^[A-Za-z0-9_-]{11}$/.test(id)) return;
          event.preventDefault();
          title.textContent = link.dataset.videoTitle || 'YouTube 影片';
          iframe.title = title.textContent;
          iframe.src = `https://www.youtube.com/embed/${id}?autoplay=1`;
          external.href = `https://www.youtube.com/watch?v=${id}`;
          dialog.showModal();
        });
      });
      dialog.querySelector('.dialog-close')?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
      dialog.addEventListener('close', () => { iframe.src = ''; });
    }
  </script>
</Base>
<style>
  .hero { padding: 6rem 0 4rem; background: linear-gradient(180deg,#1A0A45,#15083A); border-bottom: 1px solid var(--rule); }
  h1 { font-family: var(--serif); font-size: clamp(2.2rem,5vw,3.8rem); line-height: 1.15; margin: .6rem 0 1rem; background: linear-gradient(135deg,#EE359E,#815BDB); background-clip: text; -webkit-text-fill-color: transparent; }
  .channel { display: inline-block; margin-top: 1.8rem; padding: .6rem 1.2rem; border: 1px solid #815BDB; color: #fff; }
  .videos-grid { padding: 4rem 0 6rem; }
  .more { margin-top: 2rem; }
  .more a { color: #fff; text-decoration: underline; }
  .video-dialog { width: min(92vw,760px); max-height: 90vh; margin: auto; padding: 1rem; border: 1px solid #815BDB; border-radius: 8px; background: #1A0A45; color: #fff; }
  .video-dialog::backdrop { background: rgba(0,0,0,.8); }
  .dialog-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: .75rem; }
  .dialog-close { border: 0; background: transparent; color: #fff; cursor: pointer; font-size: 1.4rem; padding: .25rem .5rem; }
  .video-frame { position: relative; aspect-ratio: 16 / 9; }
  .video-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .video-external { display: inline-block; margin-top: .75rem; color: #fff; text-decoration: underline; }
</style>